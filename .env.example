# ---------------------------------------------------------------------------
# gmail-trigger-poc configuration. Copy to `.env` and adjust.
# Real environment variables override these. All values below are the defaults,
# so an empty .env works too — only the two *files* must actually exist for OAuth.
# ---------------------------------------------------------------------------

# OAuth client secret downloaded from Google Cloud Console.
# APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   -> Application type: Desktop app -> Download JSON -> save as this file.
GMAIL_CREDENTIALS_FILE=credentials.json

# Where the user token is cached after the first browser consent.
# Created automatically on first run. Treat like a password. Do NOT commit.
GMAIL_TOKEN_FILE=token.json

# Local checkpoint of the last processed Gmail historyId. Created automatically.
GMAIL_HISTORY_FILE=last_history_id.json

# Which mailbox to watch. "me" = the account you authenticated as.
GMAIL_USER_ID=me

# Seconds between polls.
GMAIL_POLL_INTERVAL_SECONDS=20

# Space- or comma-separated OAuth scopes.
#   gmail.modify  -> read + mark read/unread/archive/trash (no send, no hard delete)
# To send quotations later, add: https://www.googleapis.com/auth/gmail.send
# then DELETE token.json and re-run to re-consent.
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify

# Port for the one-time local OAuth callback. 0 = pick any free port.
# If you set a fixed port, add http://localhost:PORT/ as an authorized redirect
# URI on the OAuth client (Desktop-app clients usually accept loopback already).
OAUTH_LOCAL_SERVER_PORT=0

# Start the background poller thread when the API process boots.
# Set to false to run the HTTP API alone (e.g. to test POST /process-email).
ENABLE_POLLER=true

# uvicorn bind address for the `gmail-trigger-poc` console script.
HOST=127.0.0.1
PORT=8000

# --- Logging --------------------------------------------------------------
# Verbosity of the `gmail_trigger_poc` logger tree:
#   DEBUG  every poll cycle, Gmail API call, MIME parse, checkpoint write
#   INFO   new mail, process_email results, request lines, lifecycle (default)
#   WARNING only problems
LOG_LEVEL=INFO

# Coloured [TAG] output. Unset = auto (colour only when stdout is a terminal).
#   1/true  force colour   |   0/false  force plain   |   or set NO_COLOR=1
LOG_COLOR=

# Characters of the email body shown in the one-line "body :" preview.
LOG_BODY_PREVIEW_CHARS=200

# Also dump the FULL decoded body as an indented block (only at LOG_LEVEL=DEBUG).
LOG_FULL_BODY=false

# Print a heartbeat line every N idle poll cycles so you can see it's alive.
# 0 = never. At GMAIL_POLL_INTERVAL_SECONDS=20, 12 cycles ~= once every 4 minutes.
LOG_HEARTBEAT_EVERY=12

# --- Step 2: QuoteFlow pipeline (classify -> extract -> match -> draft) ------
# SQLite relational store. Rebuild with: python -m gmail_trigger_poc.seed
QUOTEFLOW_DB_FILE=quoteflow.db
# Seed dataset for the one-time backfill load.
QUOTEFLOW_SEED_FILE=data/quoteflow_seed.json
# ChromaDB PersistentClient directory (collection "products").
CHROMA_PATH=chroma_data

# Embedding function for the product vector store:
#   auto           -> Chroma's ONNX all-MiniLM-L6-v2 (downloads ~80MB once),
#                     falling back to the offline hash embedder if it can't load
#   chroma_default -> force MiniLM
#   hash           -> deterministic hashed bag-of-words, offline, no model
# NOTE: the Chroma collection's dimension is fixed by whoever seeds it first.
# Re-run `python -m gmail_trigger_poc.seed` after changing this.
EMBEDDING_PROVIDER=auto

# LLM for classify/extract + drafting supplier outreach:
#   auto      -> Claude if ANTHROPIC_API_KEY / `ant auth` profile resolves, else stub
#   anthropic -> always Claude (errors if no credentials)
#   stub      -> deterministic offline logic (keeps the pipeline demoable with no key)
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=4000
# Add credentials at the end: export ANTHROPIC_API_KEY=sk-ant-...  (or run `ant auth login`)

# Suppliers scoring >= this against the enquiry each get a drafted outreach email.
# Plans state 0.65; default here is 0.50 (see config.py for the reasoning; tunable).
MATCH_SCORE_THRESHOLD=0.50
# Product candidates pulled from the vector store before the SQL supplier join.
MATCH_TOP_N=10

# Broker identity used in drafted supplier outreach (matches the seed dataset).
BROKER_NAME=Meridian Trade Partners
BROKER_EMAIL=procurement@meridiantrade.com
